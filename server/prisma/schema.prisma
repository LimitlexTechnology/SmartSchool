// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id            String       @id @default(uuid())
  firstName     String
  lastName      String
  email         String       @unique
  profilePicture String?
  grade         String
  wristbandId   String?      @unique
  password      String?      // Used for student portal login
  // Extended profile
  gender        String?
  birthday      DateTime?
  admittedAt    DateTime?
  religion      String?
  nationality   String?
  hometown      String?
  address       String?
  guardianName          String?
  guardianRelationship  String?
  guardianContact       String?
  // Archiving
  status        String       @default("active")
  archivedAt    DateTime?
  archiveReason String?
  walletBalance Float        @default(0.0)
  behaviorPoints Int         @default(100)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  class         Class?       @relation(fields: [classId], references: [id])
  classId       String?
  assessments   AssessmentSubmission[]
  transactions  Transaction[]
  groups        StudentGroup[]
  behaviorLogs  BehaviorLog[]
}

model BehaviorLog {
  id          String   @id @default(uuid())
  student     Student  @relation(fields: [studentId], references: [id])
  studentId   String
  type        String   // addition, deduction
  category    String
  score       Int
  reason      String?
  authorName  String?
  createdAt   DateTime @default(now())
}

model Teacher {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  subject   String
  type      String   @default("teaching")
  lessons   Lesson[]
  profile   TeacherProfile?
  teachingAssignments TeachingAssignment[]
}

model Class {
  id        String    @id @default(uuid())
  name      String
  grade     String
  students  Student[]
  teachingAssignments TeachingAssignment[]
}

model Assessment {
  id          String   @id @default(uuid())
  title       String
  type        String   // Quiz, Test, Homework
  dueDate     DateTime
  subject     String
  submissions AssessmentSubmission[]
}

model AssessmentSubmission {
  id           String     @id @default(uuid())
  student      Student    @relation(fields: [studentId], references: [id])
  studentId    String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  assessmentId String
  score        Float?
  status       String     // Pending, Completed, Overdue
  submittedAt  DateTime?
}

model Transaction {
  id          String   @id @default(uuid())
  student     Student  @relation(fields: [studentId], references: [id])
  studentId   String
  amount      Float
  type        String   // Canteen, Library, Transport, Fee
  description String
  createdAt   DateTime @default(now())
}

model Lesson {
  id        String   @id @default(uuid())
  topic     String
  content   String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  teacherId String
  createdAt DateTime @default(now())
}

model Group {
  id          String         @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime       @default(now())
  memberships StudentGroup[]
  @@unique([name])
}

model StudentGroup {
  id         String   @id @default(uuid())
  student    Student  @relation(fields: [studentId], references: [id])
  studentId  String
  group      Group    @relation(fields: [groupId], references: [id])
  groupId    String
  createdAt  DateTime @default(now())
  @@unique([studentId, groupId])
}

model TeacherProfile {
  id                String   @id @default(uuid())
  teacher           Teacher  @relation(fields: [teacherId], references: [id])
  teacherId         String   @unique
  gender            String?
  phone             String?
  staffId           String?
  dateEmployed      DateTime?
  ssn               String?
  nationalId        String?
  dob               DateTime?
  momoNumber        String?
  accountNumber     String?
  bankBranch        String?
  bankName          String?
  nextOfKin         String?
  nextOfKinRelation String?
  nextOfKinPhone    String?
  classesTaught     String[]
  subjectsTaught    String[]
  formMaster        String?
  profilePicture    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TeachingAssignment {
  id        String  @id @default(uuid())
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  teacherId String
  class     Class   @relation(fields: [classId], references: [id])
  classId   String
  subject   String
  createdAt DateTime @default(now())
  @@unique([teacherId, classId, subject])
}
